<Window x:Class="CustomTeamAssigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="EHR Control Panel" Height="720" Width="1280" FontSize="20" MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen" Background="#1C1C1C">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Width" Value="370"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3E3E3E"/></Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#525252"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.95" Duration="0:0:0.1" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.95" Duration="0:0:0.1" AutoReverse="True"/>
                        </Storyboard></BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="LightGray"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,0,10,0"/><Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#707070"/><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Name="MainGrid">
        <Grid.Background><ImageBrush ImageSource="bg.jpg"/></Grid.Background>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Frame Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="10" Name="Navigator" NavigationUIVisibility="Hidden" Visibility="Hidden"/>
        <Label Content="EHR Control Panel" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="2" FontSize="58" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Foreground="LightGray" Name="TitleLabel"/>
        <Border Grid.Column="1" Grid.Row="2" Grid.RowSpan="5" Background="#2D2D2D" CornerRadius="20" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center" Name="ButtonGroup">
            <StackPanel>
                <Label Content="Custom Team Assignment" FontSize="14" HorizontalContentAlignment="Center" HorizontalAlignment="Center" VerticalContentAlignment="Center" Foreground="LightGray"/>
                <Button Click="CreateNewPlaySet" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                    <StackPanel Orientation="Horizontal"><svgc:SvgViewbox Source="Resources/add.svg" Width="30" Height="30"/><TextBlock Text="Create New Play-Set" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                </Button>
                <Button Click="ImportPlaySet" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                    <StackPanel Orientation="Horizontal"><svgc:SvgViewbox Source="Resources/import.svg" Width="30" Height="30"/><TextBlock Text="Import Play-Set" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                </Button>
                <Button Click="OpenPresetLists" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                    <TextBlock Text="Preset Lists" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>
        <Button Grid.Column="0" Grid.Row="7" Grid.RowSpan="2" Click="QMQuestionsClick" RenderTransformOrigin="0.5,0.5" Foreground="LightGray"><Button.RenderTransform><ScaleTransform/></Button.RenderTransform><StackPanel Orientation="Horizontal"><svgc:SvgViewbox Source="Resources/question.svg" Width="30" Height="30"/><TextBlock Text="Quiz Master Questions" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Button>
        <Button Grid.Column="1" Grid.Row="7" Grid.RowSpan="2" Click="OpenRoleDescFinder" RenderTransformOrigin="0.5,0.5" Foreground="LightGray"><Button.RenderTransform><ScaleTransform/></Button.RenderTransform><StackPanel Orientation="Horizontal"><svgc:SvgViewbox Source="Resources/search.svg" Width="30" Height="30"/><TextBlock Text="Role Description Finder" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Button>
        <Button Grid.Column="2" Grid.Row="7" Grid.RowSpan="2" Click="OpenTemplateCreator" RenderTransformOrigin="0.5,0.5" Foreground="LightGray"><Button.RenderTransform><ScaleTransform/></Button.RenderTransform><StackPanel Orientation="Horizontal"><svgc:SvgViewbox Source="Resources/template.svg" Width="30" Height="30"/><TextBlock Text="Template Creator" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Button>
    </Grid>
</Window>
